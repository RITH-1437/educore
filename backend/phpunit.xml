<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
<php>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <!-- Always the dedicated test database (tests/TestCase refuses any other). -->
        <server name="DB_DATABASE" value="educore_test" force="true"/>
        <!-- Where it lives is the environment's choice: Docker Compose sets postgres /
             educore, GitHub Actions 127.0.0.1 / postgres. These are only defaults:
             <env> without force applies only when the variable is not set
             (a <server> entry would always overwrite it). -->
        <env name="DB_HOST" value="postgres"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_USERNAME" value="educore"/>
        <env name="DB_PASSWORD" value="educore@123"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <!-- Tests log nowhere: the backend container shares storage/logs with dev. -->
        <server name="LOG_CHANNEL" value="null" force="true"/>
        <!-- Never reach the real Telegram API from tests (the local .env may hold a token). -->
        <server name="TELEGRAM_BOT_TOKEN" value="" force="true"/>
        <server name="TELEGRAM_BOT_USERNAME" value="" force="true"/>
        <server name="TELEGRAM_WEBHOOK_SECRET" value="" force="true"/>
        <server name="ACADEMIC_TIMEZONE" value="UTC" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
