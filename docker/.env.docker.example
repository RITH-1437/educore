

# --- Application (Laravel) ---
APP_NAME=EduCore
APP_ENV=docker
APP_DEBUG=true
APP_URL=http://localhost

# --- PostgreSQL (service + backend) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=educore
DB_USERNAME=educore
DB_PASSWORD=educore

POSTGRES_DB=educore
POSTGRES_USER=educore
POSTGRES_PASSWORD=educore
POSTGRES_PORT=5432
# Host port published to your machine (change if 5432 is already in use)
DB_HOST_PORT=5432

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@educore.dev
PGADMIN_DEFAULT_PASSWORD=educore_admin
PGADMIN_PORT=5050

# --- Redis (service + backend) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
# Host port published to your machine (change if 6379 is already in use)
REDIS_HOST_PORT=6379

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# --- MinIO / S3 storage ---
FILESYSTEM_DISK=s3
MINIO_ROOT_USER=educore
MINIO_ROOT_PASSWORD=educore_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=educore
AWS_SECRET_ACCESS_KEY=educore_minio_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=educore
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Frontend (Vite) ---
VITE_API_URL=/api
FRONTEND_PORT=5173

# --- Nginx ---
NGINX_PORT=80

# --- Mail (development: log only) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="EduCore"