

# --- Application (Laravel) ---
APP_NAME=EduCore
APP_ENV=docker
APP_DEBUG=true
APP_URL=http://localhost

# --- PostgreSQL (service + backend) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=educore
DB_USERNAME=educore
DB_PASSWORD=educore

POSTGRES_DB=educore
POSTGRES_USER=educore
POSTGRES_PASSWORD=educore
POSTGRES_PORT=5432
# Host port published to your machine (change if 5432 is already in use)
DB_HOST_PORT=5432

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@educore.dev
PGADMIN_DEFAULT_PASSWORD=educore_admin
PGADMIN_PORT=5050

# --- Redis (service + backend) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
# Host port published to your machine (change if 6379 is already in use)
REDIS_HOST_PORT=6379

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# --- MinIO / S3 storage ---
FILESYSTEM_DISK=s3
MINIO_ROOT_USER=educore
MINIO_ROOT_PASSWORD=educore_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=educore
AWS_SECRET_ACCESS_KEY=educore_minio_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=educore
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Frontend (Vite) ---
VITE_API_URL=/api
FRONTEND_PORT=5173
# Front-end connection origins (back-end <-> Vite). Same-origin deployments
# can leave FRONTEND_URL unset; only needed for cross-origin SPA/Vite hosts.
FRONTEND_URL=http://localhost
VITE_DEV_SERVER_URL=http://localhost:5173

# --- Nginx ---
NGINX_PORT=80

# --- Mail (development: log only) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="EduCore"

# --- Telegram (module 9.21: in-app notifications; empty disables the channel) ---
# Never commit a real token.
TELEGRAM_BOT_TOKEN=
# One-tap chat linking (report 48): the bot's @username (without @) and a
# random secret Telegram echoes on webhook calls (`php artisan telegram:webhook`).
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Institution time (report 48) ---
# Timezone of the timetable's class times: today's classes and class reminders.
ACADEMIC_TIMEZONE=Asia/Phnom_Penh
# Minutes before a class that its students and lecturers get a Telegram reminder.
CLASS_REMINDER_MINUTES=30

# --- Campus map (report 49) ---
# The map button on every page: the place pinned at "lat,lng", its address,
# and its Google Maps link (opened in a new tab).
CAMPUS_MAP_NAME="ITC Conference Hall"
CAMPUS_MAP_ADDRESS="HVCX+6F6, Russian Federation Blvd (110), Phnom Penh, Cambodia"
CAMPUS_MAP_COORDINATES="11.5705439,104.8986445"
CAMPUS_MAP_URL="https://www.google.com/maps/place/ITC+Conference+Hall/@11.5703117,104.8990476,18.11z/data=!4m6!3m5!1s0x310951738deaaaab:0x6e806285f01ccb0b!8m2!3d11.5705439!4d104.8986445!16s%2Fg%2F11kj8_wkbd"
