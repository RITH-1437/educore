@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName sans-serif
skinparam roundCorner 10

title EduCore — Timetable 3-Way Conflict Engine

start
:Submit Section Schedule (Section ID, Room ID, Day, Start/End Time);

partition "Conflict Detection Algorithm" {
  if (Room already allocated to another class on same day with overlapping time?) then (yes)
    :Abort 422 (Room Conflict: Room already occupied);
    stop
  endif

  if (Assigned Lecturer scheduled to teach another section at same time?) then (yes)
    :Abort 422 (Lecturer Conflict: Lecturer teaching elsewhere);
    stop
  endif

  if (Target Section already has another overlapping class slot?) then (yes)
    :Abort 422 (Section Conflict: Overlapping class session);
    stop
  endif
}

:Insert into schedule_entries table;
:Return HTTP 200 OK (Schedule Slot Saved);
stop

@enduml
